# Book Spirit — copy to .env and adjust

# RAG backend: native | langchain | langgraph（chat 預設 langgraph）
RAG_BACKEND=langgraph

# PDF 解析：markitdown | mineru（mineru 需安裝 CLI：uv sync --group mineru）
EXTRACT_BACKEND=markitdown
# MINERU_CMD=mineru
# MINERU_TIMEOUT=900
# MINERU_BACKEND=pipeline
# MINERU_LANG=ch
# MINERU_DEVICE=cpu
# 首次（勿省略 -s，否則會卡在互動選單）：
#   uv sync --group mineru && uv run mineru-models-download -m pipeline -s huggingface

# 分塊：semantic（預設）| native
CHUNKER_MODE=semantic
SEMANTIC_MIN_CHUNK_SIZE=128
# SEMANTIC_SIMILARITY_THRESHOLD=0.72
# SEMANTIC_BREAKPOINT_PERCENTILE=15
# 長篇章節書若 eval 變差，單本改 CHUNKER_MODE=native 後 --force 重建

# Retrieval strategy: vector | hybrid | hybrid_rerank（預設 hybrid_rerank）
# RETRIEVAL_STRATEGY=hybrid_rerank
# RETRIEVAL_MODE=hybrid
# USE_RERANK=true
# 檢索 fallback（低分）：hybrid_rerank → ↑top_k → hybrid → vector
# RETRIEVAL_MIN_TOP1_SCORE=0.55
# RETRIEVAL_RETRY_TOP_K_MULTIPLIER=2
# RETRIEVAL_MAX_TOP_K=12
# RETRIEVAL_MAX_ATTEMPTS=4
# GOLDEN_PASS_WARN_THRESHOLD=0.65

# Qdrant — local path OR remote URL (Docker Compose uses URL)
QDRANT_PATH=./qdrant_storage
# QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=books

# Embedding / LLM
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M

# LLM 檢索規劃（改寫問題後再搜尋；多一次 Ollama 呼叫）
# USE_QUERY_PLANNER=true
# SHOW_RETRIEVAL_DEBUG=true

# SQLite reading notes + profile (local memory; survives Qdrant reindex)
# NOTES_DB_PATH=data/reading_memory.db

# Postgres query log (optional; enabled when set)
# DATABASE_URL=postgresql://bookspirit:bookspirit@localhost:5432/bookspirit

# OpenAI (optional, Phase 5)
# OPENAI_API_KEY=sk-...
