# Book Spirit — copy to .env and adjust

# RAG backend default: native | langchain | langgraph
RAG_BACKEND=native

# Retrieval strategy: vector | hybrid | hybrid_rerank
# RETRIEVAL_STRATEGY=vector
# RETRIEVAL_MODE=vector
# USE_RERANK=false

# Qdrant — local path OR remote URL (Docker Compose uses URL)
QDRANT_PATH=./qdrant_storage
# QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=books

# Embedding / LLM
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M

# Postgres query log (optional; enabled when set)
# DATABASE_URL=postgresql://bookspirit:bookspirit@localhost:5432/bookspirit

# OpenAI (optional, Phase 5)
# OPENAI_API_KEY=sk-...
